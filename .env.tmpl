# Template env file — commit this, NOT real .env. Run with `bw-env .env.tmpl -- <cmd>`.
# Each `bw://item-name/field` resolves from your Bitwarden vault when you run the command.
# Default field is `password`; for custom fields name them in BW and reference here.

# Convex deploy key (per-app; generate with `npx convex dev` first time)
CONVEX_DEPLOY_KEY=bw://convex-PROJECT-SLUG/password

# Clerk (per-app)
CLERK_SECRET_KEY=bw://clerk-PROJECT-SLUG/password
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=bw://clerk-PROJECT-SLUG/publishable-key

# Stripe (test mode by default; rotate when going to live)
STRIPE_SECRET_KEY=bw://stripe/password
STRIPE_WEBHOOK_SECRET=bw://stripe/webhook-secret

# Resend (transactional email)
RESEND_API_KEY=bw://resend/password

# Telegram (per-bot; one BW item per bot you spin up)
TELEGRAM_BOT_TOKEN=bw://telegram-PROJECT-SLUG-bot/password

# Anthropic API — only fund + populate when production traffic begins.
# Local dev / agents on this Mac use Claude Max OAuth via the `claude` CLI; no key needed.
# ANTHROPIC_API_KEY=bw://anthropic/password
