{
  "mcpServers": {
    "supabase": {
      "command": "infisical",
      "args": [
        "run",
        "--projectId=00000000-0000-0000-0000-000000000000",
        "--env=dev",
        "--",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@0.14.0",
        "--read-only",
        "--project-ref=REPLACE_WITH_SUPABASE_PROJECT_REF"
      ]
    },
    "convex": {
      "command": "infisical",
      "args": [
        "run",
        "--projectId=00000000-0000-0000-0000-000000000000",
        "--env=dev",
        "--",
        "npx",
        "-y",
        "convex@latest",
        "mcp",
        "start",
        "--disable-tools",
        "run,envGet,envList,envSet,envRemove"
      ]
    }
  }
}
